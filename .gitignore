# Virtual environment — created locally, rebuilt from pyproject.toml
.venv/

# Python bytecode cache — generated when a module is imported
__pycache__/
*.pyc

# Tool caches — regenerated on every run
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Build artifacts
dist/
*.egg-info/

# Secrets — keep the example template
.env*
!.env.example

# OS and logs
.DS_Store
*.log

# Editor settings — personal, not part of the project
.vscode/

# Compiled CUDA/C outputs — rebuilt from kernels/
build/
*.o

# Profiler captures — large binaries; summaries go to results/
*.nsys-rep
*.ncu-rep

# Windows download marker, shows up when copying files into WSL
*:Zone.Identifier